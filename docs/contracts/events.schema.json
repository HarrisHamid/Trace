{
  "title": "AgentEvent",
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source text backing the claim.",
          "title": "Quote"
        },
        "status": {
          "description": "Set by the validator, never by the model. verified: the edge or the quoted source text exists. unverified: nothing backs it. gap: no edge joins this step to the previous one, or that edge is unresolved.",
          "enum": [
            "verified",
            "unverified",
            "gap"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "text",
        "status"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Done": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "done",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Done",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "FinalPath": {
      "additionalProperties": false,
      "description": "The first validated answer. A later `repair_finished` may replace it, and it stays in the run either way.",
      "properties": {
        "type": {
          "const": "final_path",
          "title": "Type",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PathStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "type",
        "steps"
      ],
      "title": "FinalPath",
      "type": "object"
    },
    "NodeVisited": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "node_visited",
          "title": "Type",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "type",
        "node_id",
        "reason"
      ],
      "title": "NodeVisited",
      "type": "object"
    },
    "PathStep": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "explanation",
        "claims"
      ],
      "title": "PathStep",
      "type": "object"
    },
    "RepairFinished": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "repair_finished",
          "title": "Type",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "accepted",
            "no_improvement",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "steps": {
          "description": "The repaired path, set by the validator. Empty unless accepted.",
          "items": {
            "$ref": "#/$defs/PathStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "type",
        "outcome",
        "steps"
      ],
      "title": "RepairFinished",
      "type": "object"
    },
    "RepairIssue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "claim",
            "gap"
          ],
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "description": "The step the issue is on. A gap belongs to the step after the missing link.",
          "title": "Node Id",
          "type": "string"
        },
        "text": {
          "description": "The flagged claim, or the validator's sentence about the gap.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id",
        "text"
      ],
      "title": "RepairIssue",
      "type": "object"
    },
    "RepairStarted": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "repair_started",
          "title": "Type",
          "type": "string"
        },
        "issues": {
          "description": "What was sent back to the model for its one repair round.",
          "items": {
            "$ref": "#/$defs/RepairIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "left_alone": {
          "description": "Flagged items not sent back, because no fix is possible: external steps, gaps with no bridge.",
          "minimum": 0,
          "title": "Left Alone",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "issues",
        "left_alone"
      ],
      "title": "RepairStarted",
      "type": "object"
    },
    "RunStarted": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "run_started",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "RunStarted",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tool_call",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "call_index": {
          "description": "0-based position of the tool call in the run. A run makes at most 8 tool calls.",
          "minimum": 0,
          "title": "Call Index",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "name",
        "args",
        "call_index"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tool_result",
          "title": "Type",
          "type": "string"
        },
        "call_index": {
          "description": "0-based position of the tool call in the run. A run makes at most 8 tool calls.",
          "minimum": 0,
          "title": "Call Index",
          "type": "integer"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "type",
        "call_index",
        "summary"
      ],
      "title": "ToolResult",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "done": "#/$defs/Done",
      "error": "#/$defs/ErrorEvent",
      "final_path": "#/$defs/FinalPath",
      "node_visited": "#/$defs/NodeVisited",
      "repair_finished": "#/$defs/RepairFinished",
      "repair_started": "#/$defs/RepairStarted",
      "run_started": "#/$defs/RunStarted",
      "tool_call": "#/$defs/ToolCall",
      "tool_result": "#/$defs/ToolResult"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RunStarted"
    },
    {
      "$ref": "#/$defs/ToolCall"
    },
    {
      "$ref": "#/$defs/ToolResult"
    },
    {
      "$ref": "#/$defs/NodeVisited"
    },
    {
      "$ref": "#/$defs/FinalPath"
    },
    {
      "$ref": "#/$defs/RepairStarted"
    },
    {
      "$ref": "#/$defs/RepairFinished"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    },
    {
      "$ref": "#/$defs/Done"
    }
  ]
}
